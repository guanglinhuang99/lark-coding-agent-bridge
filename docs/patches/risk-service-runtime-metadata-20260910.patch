+def runtime_metadata() -> dict[str, object]:
+    """Return bounded diagnostics for the already-loaded shared checker."""
+
+    checker = portfolio_connect_app.web.checker
+    functions: dict[str, dict[str, object]] = {}
+    for name in RUNTIME_FUNCTION_NAMES:
+        optimized = False
+        max_entries: int | None = None
+        try:
+            function = getattr(checker, name, None)
+            cache_info = getattr(function, "cache_info", None)
+            if (
+                callable(function)
+                and getattr(function, "__risk_text_memoized__", False) is True
+                and callable(cache_info)
+            ):
+                bound = cache_info().maxsize
+                if type(bound) is int and bound > 0:
+                    optimized = True
+                    max_entries = bound
+        except Exception:
+            # Diagnostics are optional and must not expose or propagate failures.
+            pass
+        functions[name] = {
+            "optimized": optimized,
+            "max_entries": max_entries,
+        }
+    return {
+        "schema": RUNTIME_METADATA_SCHEMA,
+        "shared_text_memoization": (
+            "optimized"
+            if all(item["optimized"] is True for item in functions.values())
+            else "unoptimized"
+        ),
+        "functions": functions,
+    }
+
